# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your_gemini_api_key_here"

# Model selection for investigation agent
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
PORT=3000

# Supabase database integration (Optional: live persistent Postgres)
SUPABASE_URL="https://your-project-id.supabase.co"
# Server-only secret key. Never prefix this variable with VITE_.
SUPABASE_SECRET_KEY="your_supabase_secret_key_here"

# Client-facing Supabase variables
VITE_SUPABASE_URL="https://zfdncxsqbcqrforvwnup.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_0bEiKkZ7gQsSQCY9NBPFOg_AIP1b5VK"
VITE_API_BASE_URL="http://localhost:3000"
